# meeting-room-booking — ตัวแปรสภาพแวดล้อม
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามจริง (ห้าม commit .env)

# ─── Database (Postgres) ───────────────────────────────
POSTGRES_DB=meeting_room
POSTGRES_USER=mrb
POSTGRES_PASSWORD=mrb_dev_password
POSTGRES_PORT=5434
DATABASE_URL=postgresql+psycopg://mrb:mrb_dev_password@localhost:5434/meeting_room

# ─── Backend (FastAPI) ─────────────────────────────────
# คีย์สำหรับเข้ารหัส JWT — ใน production ให้สุ่มค่าใหม่ เช่น: openssl rand -hex 32
JWT_SECRET=change_me_in_production
# อายุ token (ชั่วโมง)
JWT_EXPIRE_HOURS=8
TZ=Asia/Bangkok

# ─── Email (SMTP) ──────────────────────────────────────
# ปล่อยว่าง = ปิดการส่งอีเมล (ระบบยังทำงานปกติ, log แทน)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=meeting-room-booking@example.local

# ─── Frontend (Vite) ───────────────────────────────────
# URL ของ backend สำหรับ dev server (ใช้ Vite proxy แทนก็ได้)
VITE_API_BASE_URL=http://localhost:8000
